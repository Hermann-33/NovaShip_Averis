# ============ NovaShip Averis — environment (copy to .env) ============
# --- Persistence: memory (offline demo, seeded from bundle) | supabase
REPO_BACKEND=memory
TENANT_ID=tenant_april
# Supabase (Project Settings > API). Service role key stays SERVER-SIDE only.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings-api
SUPABASE_STORAGE_BUCKET=documents

# --- AI provider: none (deterministic rules only) | openai
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini           # optional OpenAI chat model override

# --- Trained intent classifier (rules remain the high-confidence first layer)
INTENT_MODEL_ENABLED=1
INTENT_MODEL_PATH=./models/intent_classifier.joblib  # relative to backend/ in local runs

# --- RAG for Ask AI (embeddings + vector store)
EMBEDDING_PROVIDER=gemini       # gemini | openai | local (offline hashing)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # aistudio.google.com/app/apikey -> Gemini text-embedding-004
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=local              # local (backend/data/index.json) | supabase (case_embeddings, migration 0003)
RAG_DATA_DIR=./data             # knowledge folder (relative to backend/)

# --- LangGraph checkpoints (paused human-in-the-loop graphs)
LANGGRAPH_CHECKPOINT=memory     # memory | postgres  (postgres needs: pip install langgraph-checkpoint-postgres "psycopg[binary]")
LANGGRAPH_PG_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
OCR_ENABLED=0                   # 1 = try pytesseract on image-only PDFs (needs tesseract + poppler installed)

# --- Auth: demo (X-User-Id header, DEMO_USER_ID fallback) | jwt (Supabase Bearer token required)
AUTH_MODE=demo
DEMO_USER_ID=u_sup_1

# --- Email connector (Microsoft Graph / Outlook 365) — optional, adapter-based
EMAIL_PROVIDER=none             # none | graph
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=xxxxxxxx
MS_MAILBOX=documentation@yourcompany.com
EMAIL_SEND_MODE=simulate        # simulate | graph  (drafts are NEVER sent without human approval)

# --- Misc
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
BUNDLE_DIR=./sdoc-hackathon-bundle
SEED_SNAPSHOT=./supabase/seed/snapshot.json
AUTO_SEED=1
NEXT_PUBLIC_API_BASE=http://localhost:8000
